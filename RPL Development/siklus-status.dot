// Render: dot -Tpng -Gdpi=150 siklus-status.dot -o ../06-siklus-status.png
digraph status {
  graph [rankdir=LR, fontname="DejaVu Sans", pad=0.4, nodesep=0.6, ranksep=0.9, bgcolor="white",
         labelloc=t, fontsize=22, label=<<B>Siklus status laporan</B><BR/><FONT POINT-SIZE="12">Setiap perubahan status dicatat di riwayat (audit trail) dan memicu notifikasi ke pelapor</FONT><BR/> >];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, margin="0.25,0.15", penwidth=1.4,
         fillcolor="#dcdcd4", color="#888880"];
  edge  [fontname="DejaVu Sans", fontsize=11, color="#333333", penwidth=1.3];

  start [shape=circle, label="", width=0.25, fillcolor="#333333", color="#333333"];
  baru  [label="Baru Diterima", fillcolor="#9de5ff", color="#3399bb"];
  ver   [label="Diverifikasi",  fillcolor="#b8abff", color="#8c7fd9"];
  proses[label="Diproses",     fillcolor="#b8abff", color="#8c7fd9"];
  selesai [label="Selesai",    fillcolor="#b5e55f", color="#6b9a1a"];
  tolak [label="Ditolak",      fillcolor="#ffd9cf", color="#d9806b"];

  start -> baru [label="  foto lolos validasi,\n  tiket terbit  "];
  baru  -> ver  [label="  valid: AI (keyakinan tinggi)\n  atau Admin  "];
  ver   -> proses [label="  ditugaskan\n  ke petugas  "];
  proses -> selesai [label="  petugas melaporkan\n  hasil perbaikan  "];
  baru -> tolak [label="  tidak valid\n  (keputusan Admin)  "];
  ver  -> tolak [style=dashed, label="  Admin menimpa hasil AI:\n  ternyata tidak valid  ", constraint=false];
}
